RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Redirecciones del sitio anterior (Hostinger Builder) a las URLs nuevas
Redirect 301 /automatizacion-procesos-automotriz /servicios/automatizacion-ia/
Redirect 301 /gestion-de-proyectos-y-producto /servicios/desarrollo-nuevos-productos/
RedirectMatch 301 ^/agente-conversacional-con-ai/?$ /servicios/automatizacion-ia/
RedirectMatch 301 ^/automatizacion-de-procesos/?$ /servicios/automatizacion-ia/
RedirectMatch 301 ^/blog(/.*)?$ /hub/

# >>> notas del sitio anterior (generado)
Redirect 301 /colaboradores-motivados-el-motor-silencioso-de-las-empresas-que-crecen-copy /hub/colaboradores-motivados/
Redirect 301 /la-movilidad-en-transicion-los-retos-digitales-que-marcaran-el-futuro-del-sector-automotriz /hub/movilidad-en-transicion/
Redirect 301 /inteligencia-artificial-automatizar-no-es-suficiente-la-diferencia-esta-en-la-experiencia /hub/ia-experiencia/
Redirect 301 /estrategias-para-potenciar-la-experiencia-del-usuario-copy /hub/experiencia-del-cliente/
Redirect 301 /estamos-listos-para-disenar-procesos-digitales-seguros-y-transparentes-copy /hub/procesos-digitales-seguros/
Redirect 301 /la-entrega-emotiva-como-construir-una-experiencia-verdaderamente-diferenciada-en-la-industria-automotriz-copy /hub/entrega-emotiva/
Redirect 301 /automatizacion-de-procesos-en-la-industria-automotriz-utilizando-la-tecnologia-copy /hub/automatizacion-procesos-automotriz/
Redirect 301 /el-sitio-web-como-canal-de-ventas-de-presencia-digital-a-motor-de-crecimiento /hub/sitio-web-canal-de-ventas/
Redirect 301 /como-digitalizar-un-proceso-de-venta-automotriz /hub/digitalizar-proceso-venta-automotriz/
Redirect 301 /la-nueva-experiencia-al-cliente-en-seminuevos /hub/seminuevos-experiencia-cliente/
Redirect 301 /que-es-y-como-funciona-una-agencia-especializada-de-seminuevos /hub/agencia-seminuevos/
Redirect 301 /como-hago-crecer-mis-ventas /hub/crecer-ventas/
Redirect 301 /como-disenar-estrategias-de-comunicacion-digital /hub/estrategias-comunicacion-digital/
# <<< notas del sitio anterior

# No exponer archivos del repositorio ni el generador
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/_build
RedirectMatch 404 ^/README\.md$

ErrorDocument 404 /404.html

# STAGING: no indexar mientras el sitio vive en el subdominio provisorio.
# Borrar estas 3 líneas el día del lanzamiento (junto con STAGING = False en _build/build.py).
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Caché de recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
</IfModule>
