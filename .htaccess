RewriteEngine On

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# Redirecciones del sitio anterior (Hostinger Builder) a las URLs nuevas
Redirect 301 /automatizacion-procesos-automotriz /servicios/automatizacion-ia/
Redirect 301 /gestion-de-proyectos-y-producto /servicios/desarrollo-nuevos-productos/
RedirectMatch 301 ^/blog(/.*)?$ /hub/

# >>> notas del sitio anterior (generado)
Redirect 301 /colaboradores-motivados-el-motor-silencioso-de-las-empresas-que-crecen-copy /hub/colaboradores-motivados/
Redirect 301 /la-movilidad-en-transicion-los-retos-digitales-que-marcaran-el-futuro-del-sector-automotriz /hub/movilidad-en-transicion/
Redirect 301 /inteligencia-artificial-automatizar-no-es-suficiente-la-diferencia-esta-en-la-experiencia /hub/ia-experiencia/
# <<< notas del sitio anterior

# No exponer archivos del repositorio ni el generador
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/_build
RedirectMatch 404 ^/README\.md$

ErrorDocument 404 /404.html

# STAGING: no indexar mientras el sitio vive en el subdominio provisorio.
# Borrar estas 3 líneas el día del lanzamiento (junto con STAGING = False en _build/build.py).
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Caché de recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
</IfModule>
